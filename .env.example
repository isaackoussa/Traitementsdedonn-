# Copie ce fichier en « .env » pour tester la connexion en local (netlify dev).
# En production, ces variables se règlent dans Netlify → Project configuration → Environment variables.

# Envoi des codes de connexion via Brevo
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=DataLab
# Liste Brevo dans laquelle ranger les utilisateurs (facultatif, numéro de la liste)
BREVO_LIST_ID=

# Clé de la console admin (/#admin)
ADMIN_KEY=

# En local sans Brevo : les e-mails (et donc les codes) s'affichent dans le terminal
MAIL_DRY_RUN=1
